---
import { site, url } from '../config';
import '../styles/global.css';
interface Props { title?: string; description?: string; article?: boolean; }
const { title, description = site.description, article = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const current = Astro.url.pathname;
const navigation = [['首页', ''], ['归档', 'archive/'], ['标签', 'tags/'], ['关于', 'about/']];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="theme-color" content="#f8f7f3" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={new URL(current, Astro.site)} />
    <meta property="og:locale" content="zh_CN" />
    <link rel="canonical" href={new URL(current, Astro.site)} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={url('rss.xml')} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header wrap">
      <a class="brand" href={url()} aria-label="ThreeFire 首页"><img src={url('favicon.svg')} width="35" height="35" alt="" /><span>ThreeFire<span class="brand-dot">.</span></span></a>
      <nav aria-label="主导航">{navigation.map(([label, path]) => <a href={url(path)} aria-current={current.replace(/\/$/, '') === url(path).replace(/\/$/, '') ? 'page' : undefined}>{label}</a>)}</nav>
      <a class="github-link" href={site.github}>GitHub <span aria-hidden="true">↗</span></a>
    </header>
    <main id="main" class="wrap"><slot /></main>
    <footer class="site-footer wrap"><span>© {new Date().getFullYear()} {site.author}<span class="footer-note"> · 保持好奇，持续记录。</span></span><div><a href={url('rss.xml')}>RSS 订阅 ↗</a><a href={site.repository}>博客源码 ↗</a></div></footer>
  </body>
</html>
