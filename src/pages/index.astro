---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/posts';
import { url } from '../config';
const posts = await getPosts();
---
<Base>
  <section class="hero">
    <div><p class="eyebrow"><span class="status-dot"></span> THREEFIRE’S DIGITAL GARDEN</p><h1>把探索写下来，<br />让思考<span class="accent">慢慢生长。</span></h1><p class="hero-description">你好，这里是三火的博客。<br />记录技术探索、学习笔记，以及实践中的一点思考。</p><a class="text-link" href="#latest">从最近的记录开始 <span aria-hidden="true">↓</span></a></div>
    <div class="garden-art" aria-hidden="true"><div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div><div class="art-grid"></div><div class="art-label">IDEAS TAKE ROOT.</div><svg viewBox="0 0 300 280" fill="none"><path d="M153 238V110M153 192L107 145M153 160L204 111M153 133L124 102" stroke="#527c61" stroke-width="3"/><path d="M153 112C109 108 112 67 127 41C158 62 173 87 153 112Z" fill="#739978"/><path d="M109 148C66 158 48 127 47 94C84 96 111 112 109 148Z" fill="#9eb58a"/><path d="M198 116C192 79 223 61 252 61C249 95 231 119 198 116Z" fill="#527c61"/><path d="M153 199C157 161 190 149 219 155C211 186 188 206 153 199Z" fill="#a6b892"/><path d="M118 229H185L176 267H128Z" fill="#d8c6a3"/><path d="M111 228H191" stroke="#b9a684" stroke-width="5" stroke-linecap="round"/></svg><span class="art-caption">一点积累 · 一点生长</span></div>
  </section>
  <section id="latest" class="posts-section">
    <div class="section-header"><div><p class="eyebrow">THE NOTEBOOK</p><h2>最近的记录 <span class="count">{String(posts.length).padStart(2, '0')}</span></h2></div><a class="muted-link" href={url('archive/')}>全部文章 <span aria-hidden="true">→</span></a></div>
    {posts.slice(0, 6).map(post => <PostCard post={post} />)}
    {posts.length === 0 && <p class="empty-state">新的记录正在酝酿中。</p>}
  </section>
  <aside class="home-note"><span class="note-symbol" aria-hidden="true">✳</span><div><h2>给思考留一个地方。</h2><p>不必等到完全想明白，记录本身就是理解的一部分。</p></div><a href={url('about/')}>关于这个博客 ↗</a></aside>
</Base>
