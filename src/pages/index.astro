---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/posts';
import { url } from '../config';
const posts = await getPosts();
---
<Base>
  <section class="hero">
    <p class="eyebrow">NOTES BY THREEFIRE</p>
    <h1>写下来，慢慢想明白。</h1>
    <p class="hero-description">你好，我是三火。这里记录技术探索、学习笔记，<br class="desktop-break" />以及实践中值得反复回看的思考。</p>
  </section>
  <section id="latest" class="posts-section">
    <div class="section-header"><h2>最近的记录</h2><a class="muted-link" href={url('archive/')}>全部 {posts.length} 篇 <span aria-hidden="true">→</span></a></div>
    {posts.slice(0, 6).map(post => <PostCard post={post} />)}
    {posts.length === 0 && <p class="empty-state">新的记录正在酝酿中。</p>}
  </section>
</Base>
