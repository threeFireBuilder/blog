---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';
import { formatDate, url } from '../../config';
export async function getStaticPaths() { return (await getPosts()).map(post => ({ params: { id: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---
<Base title={post.data.title} description={post.data.description} article>
  <article>
    <header class="article-heading"><a class="muted-link" href={url('archive/')}>← 全部文章</a><p class="eyebrow"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · THREEFIRE</p><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <a href={url(`tags/${encodeURIComponent(tag)}/`)}>{tag}</a>)}</div></header>
    <div class="article-layout"><div class="prose"><Content /></div>{toc.length > 0 && <aside class="toc"><nav aria-label="文章目录"><p class="eyebrow">本篇目录</p>{toc.map(heading => <a class:list={{ nested: heading.depth === 3 }} href={`#${heading.slug}`}>{heading.text}</a>)}</nav></aside>}</div>
    <div class="article-end"><span>感谢阅读，下篇见。</span><a href={url('archive/')}>继续浏览 →</a></div>
  </article>
</Base>
