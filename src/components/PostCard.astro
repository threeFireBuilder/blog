---
import type { CollectionEntry } from 'astro:content';
import { formatDate, url } from '../config';
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
---
<article class="post-card" data-post data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}>
  <div class="post-date"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>NOTE</span></div>
  <div class="post-info"><h3><a href={url(`posts/${post.id}/`)}>{post.data.title}</a></h3><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <a href={url(`tags/${encodeURIComponent(tag)}/`)}>{tag}</a>)}</div></div>
  <a class="read-arrow" href={url(`posts/${post.id}/`)} aria-label={`阅读：${post.data.title}`}>↗</a>
</article>
