---
import type { CollectionEntry } from 'astro:content';
import { formatDate, url } from '../config';
interface Props { post: CollectionEntry<'posts'>; heading?: 'h2' | 'h3' | 'h4'; }
const { post, heading: Heading = 'h3' } = Astro.props;
---
<article class="post-card" data-post data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}>
  <div class="post-date"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></div>
  <div class="post-info"><Heading class="post-title"><a href={url(`posts/${post.id}/`)}>{post.data.title}</a></Heading><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <a href={url(`tags/${encodeURIComponent(tag)}/`)}><span aria-hidden="true">#</span>{tag}</a>)}</div></div>
</article>
